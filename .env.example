PORT=3000
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASS="postgres"
DB_NAME="verdear"
JWT_SECRET="default_secret"
# Origens permitidas no CORS, separadas por vírgula (ex: https://app.seudominio.com)
CORS_ORIGIN="http://localhost:5173"
# OpenRouteService (frete por km, VER-91). Chave gratuita em https://openrouteservice.org/dev/#/signup
# Nunca versione a chave real. Sem ela, o frete por km responde 503 e vendedores sem origem seguem na taxa fixa.
ORS_API_KEY=""
# Opcionais: tempo limite da chamada (ms) e limite de simulações por minuto por IP em POST /frete/calcular-rota
# ORS_TIMEOUT_MS=8000
# SHIPPING_ROUTE_RATE_LIMIT=30