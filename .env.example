PORT=3000
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASS="postgres"
DB_NAME="verdear"
JWT_SECRET="default_secret"
# Origens permitidas no CORS, separadas por vírgula (ex: https://app.seudominio.com)
CORS_ORIGIN="http://localhost:5173"
# OpenRouteService (frete por km, VER-91). Chave gratuita em https://openrouteservice.org/dev/#/signup
# Nunca versione a chave real. Sem ela, o frete por km responde 503 e vendedores sem origem seguem na taxa fixa.
ORS_API_KEY=""
# Opcionais: tempo limite da chamada (ms) e limite de simulações por minuto por IP em POST /frete/calcular-rota
# ORS_TIMEOUT_MS=8000
# SHIPPING_ROUTE_RATE_LIMIT=30
# Atrás de proxy reverso (Coolify/Traefik), número de proxies confiáveis (ex.: 1) para os limites por IP
# usarem o IP real do visitante. Deixe sem definir no acesso direto local.
# TRUST_PROXY=1
# Opcional: limite de cadastros por hora por IP em POST /auth/register (padrão 10)
# REGISTER_RATE_LIMIT=10

# Resend (e-mails transacionais, VER-83). Chave gratuita em https://resend.com (3.000 e-mails/mês).
# Nunca versione a chave real. Sem ela, nenhum e-mail é enviado e a API segue funcionando normalmente.
RESEND_API_KEY=""
# Remetente dos e-mails. Precisa ser de um domínio verificado no Resend; sem domínio, use
# "VerdeAr <onboarding@resend.dev>" (só entrega para o e-mail dono da conta do Resend).
EMAIL_FROM="VerdeAr <onboarding@resend.dev>"
# Opcional: endereço do frontend para os botões "Ver meu pedido" dos e-mails. Sem ele, os e-mails saem sem botão.
# APP_URL="http://localhost:5173"
# Opcional: intervalo mínimo entre e-mails, em ms (padrão 500, ou seja, até 2 por segundo)
# EMAIL_SEND_INTERVAL_MS=500

# Cloudflare R2 (upload de imagens dos produtos, VER-87). Peça as credenciais ao TL por canal privado.
# Nunca versione os valores reais. Sem elas, POST /upload/presigned-url responde 503 e o resto da API segue normal.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# URL pública do bucket (domínio próprio ou r2.dev), sem barra no final
R2_PUBLIC_URL=""
# Opcional: limite de pedidos de URL de upload por minuto por IP
# UPLOAD_RATE_LIMIT=30
