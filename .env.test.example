# Variáveis dos testes de integração. Copie para .env.test (não versionado).
# O banco precisa ser exclusivo de testes: o nome deve terminar em "_test".
# Nunca aponte para o banco de homologação ou de produção.
NODE_ENV="test"
PORT=3001
DB_HOST="localhost"
DB_PORT=5433
DB_USER="postgres"
DB_PASS="postgres"
DB_NAME="verdear_test"
JWT_SECRET="test_secret"
CORS_ORIGIN="http://localhost:5173"
