# Variáveis dos testes de integração. Copie para .env.test (não versionado).
# O banco precisa ser exclusivo de testes: o nome deve terminar em "_test".
# Nunca aponte para o banco de homologação ou de produção.
NODE_ENV="test"
PORT=3001
DB_HOST="localhost"
DB_PORT=5433
DB_USER="postgres"
DB_PASS="postgres"
DB_NAME="verdear_test"
JWT_SECRET="test_secret"
CORS_ORIGIN="http://localhost:5173"
# Os testes simulam o OpenRouteService e definem a própria chave falsa: não use uma chave real aqui.
ORS_API_KEY=""
# Os testes não enviam e-mails: deixe a chave do Resend vazia.
RESEND_API_KEY=""
EMAIL_FROM="VerdeAr <onboarding@resend.dev>"
# Os testes de upload definem credenciais falsas da R2 (a assinatura é local, sem rede): não use as reais aqui.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
