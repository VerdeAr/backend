    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/swagger-ui-express": "^4.1.8",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
